{
  "schemaVersion": 1,
  "id": "clartek.omamesh",
  "name": "Omamesh",
  "version": "0.1.0",
  "author": "Josh Clarke",
  "license": "MIT",
  "description": "MeshCore companions, nodes, and messages in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omamesh",
    "description": "Connect to MeshCore companions over BLE, USB, or TCP/IP.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "serialPort": "/dev/ttyACM0",
      "refreshIntervalSec": 10,
      "commandTimeoutSec": 12
    },
    "schema": [
      {
        "key": "serialPort",
        "type": "string",
        "label": "USB serial port",
        "defaultValue": "/dev/ttyACM0"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "commandTimeoutSec",
        "type": "integer",
        "label": "Command timeout (seconds)",
        "min": 3,
        "max": 60,
        "step": 1,
        "defaultValue": 12
      }
    ]
  }
}
